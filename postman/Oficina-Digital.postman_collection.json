        },
        {
          "name": "Registrar entrega",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/entrega"
          }
        }
      ]
    },
    {
      "name": "Carga de demonstração — status da OS",
      "description": "Requer a carga scripts/carga-demonstracao.sql. São OS separadas posicionadas em cada status para experimentar as próximas ações. Os registros DEMO são compartilhados e podem mudar após chamadas de transição.",
      "item": [
        {
          "name": "Consultar OS de demonstração",
          "request": {
