  "item": [
    {
      "name": "Autenticação e saúde",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health",
            "description": "Verifica se a aplicação está respondendo."
          }
        },
        {
          "name": "Login administrativo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const resposta = pm.response.json();",
                  "  pm.environment.set('token', resposta.token);",
                  "  console.log('Token Bearer salvo no ambiente ativo.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/autenticacao/login",
            "description": "Preencha adminEmail e adminPassword no ambiente Postman. O teste salva o JWT automaticamente na variável token."
          }
        }
      ]
    },
    {
