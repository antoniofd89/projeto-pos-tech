    {
      "name": "Ordens de serviço — fluxo completo",
      "description": "Execute as requisições em sequência. A abertura salva ordemServicoId e codigoAcompanhamento automaticamente.",
      "item": [
        {
          "name": "Abrir OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const r = pm.response.json(); pm.environment.set('ordemServicoId', r.ordemServico.id); pm.environment.set('codigoAcompanhamento', r.codigoAcompanhamento); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"descricaoInicial\": \"Ruído ao frear; verificar sistema de freios.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/ordens-servico"
          }
        },
        {
          "name": "Listar OS",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ordens-servico?pagina=0&tamanho=20"
          }
        },
        {
          "name": "Detalhar OS atual",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}"
          }
        },
        {
          "name": "Cancelar OS atual (ramo alternativo)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}",
            "description": "Execute em uma OS ainda não iniciada para testar cancelamento. Após cancelar, não continue o fluxo principal desta OS."
          }
        },
        {
          "name": "Iniciar diagnóstico",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/diagnostico/iniciar"
          }
        },
        {
          "name": "Registrar diagnóstico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Pastilhas dianteiras desgastadas; recomenda-se substituição.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/diagnostico"
          }
        },
        {
          "name": "Adicionar serviço à OS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"servicoId\": \"{{servicoId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/servicos"
          }
        },
        {
          "name": "Adicionar material à OS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemEstoqueId\": \"{{itemEstoqueId}}\",\n  \"quantidade\": 1.000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/materiais"
          }
        },
        {
          "name": "Gerar orçamento",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/orcamentos"
          }
        },
        {
          "name": "Disponibilizar orçamento",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/orcamentos/disponibilizar"
          }
        },
        {
          "name": "Aprovar orçamento por ID",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/orcamentos/aprovar",
            "description": "Ação autenticada disponível no controller para aprovar o orçamento pelo ID da OS."
          }
        },
        {
          "name": "Rejeitar orçamento por ID",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/orcamentos/rejeitar",
            "description": "Ação autenticada disponível no controller para rejeitar o orçamento pelo ID da OS."
          }
        },
        {
          "name": "Acompanhar OS (cliente, público)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/ordens-servico/acompanhamento/{{codigoAcompanhamento}}"
          }
        },
        {
          "name": "Aprovar orçamento (cliente, público)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/acompanhamento/{{codigoAcompanhamento}}/orcamento/aprovar"
          }
        },
        {
          "name": "Rejeitar orçamento (alternativa pública)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/acompanhamento/{{codigoAcompanhamento}}/orcamento/rejeitar",
            "description": "Use como alternativa à aprovação. A rejeição retorna a OS ao diagnóstico; não execute depois de aprovar o mesmo orçamento."
          }
        },
        {
          "name": "Iniciar execução",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/execucao/iniciar"
          }
        },
        {
          "name": "Finalizar OS",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/finalizar"
