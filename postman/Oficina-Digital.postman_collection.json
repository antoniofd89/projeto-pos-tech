        {
          "name": "Aprovar orçamento da OS DEMO (público)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/acompanhamento/{{codigoAprovacaoDemo}}/orcamento/aprovar"
          }
        },
        {
          "name": "Finalizar OS DEMO em execução",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemExecucaoDemoId}}/finalizar"
          }
        },
        {
          "name": "Entregar OS DEMO finalizada",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ordens-servico/{{ordemFinalizadaDemoId}}/entrega"
