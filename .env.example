# Copie para .env e substitua os valores antes de iniciar o ambiente.
POSTGRES_DB=oficina_digital
POSTGRES_USER=oficina
POSTGRES_PASSWORD=troque-esta-senha-local

# Use um segredo aleatório com pelo menos 32 bytes. Não versione o arquivo .env.
JWT_SECRET=coloque-uma-chave-aleatoria-com-32-bytes-ou-mais
JWT_ISSUER=oficina-digital
JWT_TTL=PT15M

# Se configurados juntos, o usuário será criado como ADMIN na primeira inicialização.
ADMIN_EMAIL=admin@oficina.local
ADMIN_PASSWORD=troque-esta-senha-local-12
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
