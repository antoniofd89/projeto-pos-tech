%% Event Storming - Oficina Digital
%% Convenções: comandos no infinitivo; eventos no passado; mudanças de status são consequências do domínio.
flowchart TB

    subgraph LEGENDA["Legenda"]
        direction LR
        L_AT["Ator"]:::ator
        L_CMD["Comando"]:::comando
        L_AG["Agregado"]:::agregado
        L_EV["Evento de domínio"]:::evento
        L_POL["Política"]:::politica
        L_RM["Read model / consulta"]:::leitura
        L_EXT["Sistema externo"]:::externo
        L_HOT["Questão em aberto"]:::hotspot
    end

    subgraph IDENTIDADE["BC - Identidade e Acesso"]
        direction LR
        AT_USUARIO["Administrador / Atendente / Mecânico"]:::ator
        CMD_AUTENTICAR["Autenticar usuário"]:::comando
        AG_USUARIO["Usuário administrativo"]:::agregado
        EV_AUTENTICADO["Usuário autenticado"]:::evento
        EV_AUTENTICACAO_RECUSADA["Autenticação recusada"]:::evento
        POL_EMITIR_JWT["Emitir JWT com perfil e expiração"]:::politica
        EXT_JWT["Token JWT"]:::externo
        POL_AUTORIZAR["Autorizar ação conforme perfil"]:::politica
        EV_ACESSO_NEGADO["Acesso negado"]:::evento

        AT_USUARIO --> CMD_AUTENTICAR --> AG_USUARIO
        AG_USUARIO -->|"credenciais válidas"| EV_AUTENTICADO --> POL_EMITIR_JWT --> EXT_JWT
        AG_USUARIO -->|"credenciais inválidas"| EV_AUTENTICACAO_RECUSADA
        EXT_JWT --> POL_AUTORIZAR
        POL_AUTORIZAR -->|"sem permissão"| EV_ACESSO_NEGADO
    end

    subgraph ATENDIMENTO["BC - Atendimento: clientes e veículos"]
        direction LR
        AT_ATENDENTE["Atendente"]:::ator
        RM_CLIENTE_DOCUMENTO["Consultar cliente por CPF ou CNPJ"]:::leitura
        POL_CLIENTE_INEXISTENTE["Se não existir, solicitar cadastro"]:::politica
        CMD_CADASTRAR_CLIENTE["Cadastrar cliente"]:::comando
        AG_CLIENTE["Cliente"]:::agregado
        EV_CLIENTE_CADASTRADO["Cliente cadastrado"]:::evento
        CMD_ATUALIZAR_CLIENTE["Atualizar cliente"]:::comando
        EV_CLIENTE_ATUALIZADO["Cliente atualizado"]:::evento
        CMD_INATIVAR_CLIENTE["Inativar cliente"]:::comando
        EV_CLIENTE_INATIVADO["Cliente inativado"]:::evento

        RM_VEICULOS_CLIENTE["Consultar veículos do cliente"]:::leitura
        POL_VEICULO_INEXISTENTE["Se não existir, solicitar cadastro"]:::politica
        CMD_CADASTRAR_VEICULO["Cadastrar veículo"]:::comando
        AG_VEICULO["Veículo"]:::agregado
        EV_VEICULO_CADASTRADO["Veículo cadastrado"]:::evento
        CMD_ATUALIZAR_VEICULO["Atualizar veículo"]:::comando
        EV_VEICULO_ATUALIZADO["Veículo atualizado"]:::evento
        RM_CLIENTE_VEICULO["Cliente e veículo selecionados"]:::leitura

        AT_ATENDENTE --> RM_CLIENTE_DOCUMENTO
        RM_CLIENTE_DOCUMENTO -->|"não encontrado"| POL_CLIENTE_INEXISTENTE --> CMD_CADASTRAR_CLIENTE
        CMD_CADASTRAR_CLIENTE --> AG_CLIENTE --> EV_CLIENTE_CADASTRADO
        AT_ATENDENTE --> CMD_ATUALIZAR_CLIENTE --> AG_CLIENTE --> EV_CLIENTE_ATUALIZADO
        AT_ATENDENTE --> CMD_INATIVAR_CLIENTE --> AG_CLIENTE --> EV_CLIENTE_INATIVADO
        RM_CLIENTE_DOCUMENTO -->|"encontrado"| RM_VEICULOS_CLIENTE
        EV_CLIENTE_CADASTRADO --> RM_VEICULOS_CLIENTE
        RM_VEICULOS_CLIENTE -->|"não encontrado"| POL_VEICULO_INEXISTENTE --> CMD_CADASTRAR_VEICULO
        CMD_CADASTRAR_VEICULO --> AG_VEICULO --> EV_VEICULO_CADASTRADO
        AT_ATENDENTE --> CMD_ATUALIZAR_VEICULO --> AG_VEICULO --> EV_VEICULO_ATUALIZADO
        RM_VEICULOS_CLIENTE -->|"encontrado"| RM_CLIENTE_VEICULO
        EV_VEICULO_CADASTRADO --> RM_CLIENTE_VEICULO
    end

    subgraph CATALOGO["BC - Catálogo de Serviços"]
        direction LR
        AT_ADMIN_CATALOGO["Administrador"]:::ator
        CMD_CADASTRAR_SERVICO["Cadastrar serviço"]:::comando
        CMD_ATUALIZAR_SERVICO["Atualizar serviço"]:::comando
        CMD_ATIVAR_SERVICO["Ativar serviço"]:::comando
        CMD_INATIVAR_SERVICO["Inativar serviço"]:::comando
        AG_SERVICO["Serviço do catálogo"]:::agregado
        EV_SERVICO_CADASTRADO["Serviço cadastrado"]:::evento
        EV_SERVICO_ATUALIZADO["Serviço atualizado"]:::evento
        EV_SERVICO_ATIVADO["Serviço ativado"]:::evento
        EV_SERVICO_INATIVADO["Serviço inativado"]:::evento
        RM_SERVICOS_ATIVOS["Consultar serviços ativos, preços e duração"]:::leitura

        AT_ADMIN_CATALOGO --> CMD_CADASTRAR_SERVICO --> AG_SERVICO --> EV_SERVICO_CADASTRADO
        AT_ADMIN_CATALOGO --> CMD_ATUALIZAR_SERVICO --> AG_SERVICO --> EV_SERVICO_ATUALIZADO
        AT_ADMIN_CATALOGO --> CMD_ATIVAR_SERVICO --> AG_SERVICO --> EV_SERVICO_ATIVADO
        AT_ADMIN_CATALOGO --> CMD_INATIVAR_SERVICO --> AG_SERVICO --> EV_SERVICO_INATIVADO
        EV_SERVICO_CADASTRADO --> RM_SERVICOS_ATIVOS
        EV_SERVICO_ATUALIZADO --> RM_SERVICOS_ATIVOS
        EV_SERVICO_ATIVADO --> RM_SERVICOS_ATIVOS
        EV_SERVICO_INATIVADO --> RM_SERVICOS_ATIVOS
    end

    subgraph ESTOQUE["BC - Estoque de Peças e Insumos"]
        direction LR
        AT_ADMIN_ESTOQUE["Administrador / Estoquista"]:::ator
        CMD_CADASTRAR_ITEM["Cadastrar item de estoque"]:::comando
        AG_ITEM_ESTOQUE["Item de estoque"]:::agregado
        EV_ITEM_CADASTRADO["Item de estoque cadastrado"]:::evento
        CMD_REGISTRAR_ENTRADA["Registrar entrada"]:::comando
        EV_ENTRADA_REGISTRADA["Entrada de estoque registrada"]:::evento
        RM_ESTOQUE_DISPONIVEL["Consultar estoque físico, reservado e disponível"]:::leitura
        CMD_RESERVAR_MATERIAIS["Reservar materiais da OS"]:::comando
        EV_MATERIAIS_RESERVADOS["Materiais reservados"]:::evento
        EV_RESERVA_RECUSADA["Reserva recusada por saldo insuficiente"]:::evento
        CMD_CONSUMIR_RESERVA["Consumir materiais reservados"]:::comando
        EV_MATERIAIS_CONSUMIDOS["Materiais consumidos"]:::evento
        CMD_ESTORNAR_RESERVA["Estornar reserva da OS"]:::comando
        EV_RESERVA_ESTORNADA["Reserva estornada"]:::evento
        POL_VERIFICAR_MINIMO["Verificar estoque mínimo após movimentação"]:::politica
        EV_ESTOQUE_MINIMO["Estoque mínimo atingido"]:::evento
        POL_NOTIFICAR_REPOSICAO["Notificar necessidade de reposição"]:::politica

        AT_ADMIN_ESTOQUE --> CMD_CADASTRAR_ITEM --> AG_ITEM_ESTOQUE --> EV_ITEM_CADASTRADO
        AT_ADMIN_ESTOQUE --> CMD_REGISTRAR_ENTRADA --> AG_ITEM_ESTOQUE --> EV_ENTRADA_REGISTRADA
        EV_ITEM_CADASTRADO --> RM_ESTOQUE_DISPONIVEL
        EV_ENTRADA_REGISTRADA --> RM_ESTOQUE_DISPONIVEL
        CMD_RESERVAR_MATERIAIS --> AG_ITEM_ESTOQUE
        AG_ITEM_ESTOQUE -->|"saldo suficiente"| EV_MATERIAIS_RESERVADOS
        AG_ITEM_ESTOQUE -->|"saldo insuficiente"| EV_RESERVA_RECUSADA
        CMD_CONSUMIR_RESERVA --> AG_ITEM_ESTOQUE --> EV_MATERIAIS_CONSUMIDOS
        CMD_ESTORNAR_RESERVA --> AG_ITEM_ESTOQUE --> EV_RESERVA_ESTORNADA
        EV_ENTRADA_REGISTRADA --> POL_VERIFICAR_MINIMO
        EV_MATERIAIS_CONSUMIDOS --> POL_VERIFICAR_MINIMO
        EV_RESERVA_ESTORNADA --> POL_VERIFICAR_MINIMO
        POL_VERIFICAR_MINIMO -->|"abaixo ou igual ao mínimo"| EV_ESTOQUE_MINIMO --> POL_NOTIFICAR_REPOSICAO
        EV_MATERIAIS_RESERVADOS --> RM_ESTOQUE_DISPONIVEL
        EV_MATERIAIS_CONSUMIDOS --> RM_ESTOQUE_DISPONIVEL
        EV_RESERVA_ESTORNADA --> RM_ESTOQUE_DISPONIVEL
    end

    subgraph ORDEM_SERVICO["BC Principal - Ordem de Serviço"]
        direction TB

        subgraph ABERTURA["Abertura"]
            direction LR
            CMD_ABRIR_OS["Abrir ordem de serviço"]:::comando
            AG_OS["Ordem de serviço"]:::agregado
            EV_OS_RECEBIDA["Ordem de serviço recebida"]:::evento
            RM_OS_DETALHE["Detalhamento da OS"]:::leitura

            CMD_ABRIR_OS --> AG_OS --> EV_OS_RECEBIDA --> RM_OS_DETALHE
        end

        subgraph DIAGNOSTICO["Diagnóstico e composição"]
            direction LR
            AT_MECANICO["Mecânico"]:::ator
            CMD_INICIAR_DIAGNOSTICO["Iniciar diagnóstico"]:::comando
            EV_DIAGNOSTICO_INICIADO["Diagnóstico iniciado<br/>status: EM_DIAGNOSTICO"]:::evento
            CMD_REGISTRAR_DIAGNOSTICO["Registrar diagnóstico"]:::comando
            EV_DIAGNOSTICO_REGISTRADO["Diagnóstico registrado"]:::evento
            CMD_ADICIONAR_SERVICO["Adicionar serviço"]:::comando
            EV_SERVICO_ADICIONADO["Serviço adicionado à OS"]:::evento
            CMD_ADICIONAR_MATERIAL["Adicionar peça ou insumo"]:::comando
            EV_MATERIAL_ADICIONADO["Material adicionado à OS"]:::evento

            AT_MECANICO --> CMD_INICIAR_DIAGNOSTICO --> AG_OS --> EV_DIAGNOSTICO_INICIADO
            AT_MECANICO --> CMD_REGISTRAR_DIAGNOSTICO --> AG_OS --> EV_DIAGNOSTICO_REGISTRADO
            AT_MECANICO --> CMD_ADICIONAR_SERVICO --> AG_OS --> EV_SERVICO_ADICIONADO
            AT_MECANICO --> CMD_ADICIONAR_MATERIAL --> AG_OS --> EV_MATERIAL_ADICIONADO
        end

        subgraph ORCAMENTO["Orçamento e decisão do cliente"]
            direction LR
            CMD_GERAR_ORCAMENTO["Gerar orçamento"]:::comando
            EV_ORCAMENTO_GERADO["Orçamento gerado com versão e total"]:::evento
            CMD_DISPONIBILIZAR_ORCAMENTO["Disponibilizar orçamento"]:::comando
            EV_ORCAMENTO_DISPONIBILIZADO["Orçamento disponibilizado<br/>status: AGUARDANDO_APROVACAO"]:::evento
            RM_ORCAMENTO_CLIENTE["Consultar orçamento vigente"]:::leitura
            AT_CLIENTE["Cliente"]:::ator
            CMD_APROVAR_ORCAMENTO["Aprovar versão do orçamento"]:::comando
            EV_ORCAMENTO_APROVADO["Orçamento aprovado"]:::evento
            CMD_REJEITAR_ORCAMENTO["Rejeitar versão do orçamento"]:::comando
            EV_ORCAMENTO_REJEITADO["Orçamento rejeitado"]:::evento
            POL_RETOMAR_DIAGNOSTICO["Retomar diagnóstico e criar nova versão"]:::politica
            EV_DIAGNOSTICO_RETOMADO["Diagnóstico retomado<br/>status: EM_DIAGNOSTICO"]:::evento
            EV_APROVACAO_RECUSADA["Aprovação recusada<br/>orçamento expirado ou desatualizado"]:::evento

            EV_DIAGNOSTICO_REGISTRADO --> CMD_GERAR_ORCAMENTO
            EV_SERVICO_ADICIONADO --> CMD_GERAR_ORCAMENTO
            EV_MATERIAL_ADICIONADO --> CMD_GERAR_ORCAMENTO
            CMD_GERAR_ORCAMENTO --> AG_OS --> EV_ORCAMENTO_GERADO
            EV_ORCAMENTO_GERADO --> CMD_DISPONIBILIZAR_ORCAMENTO --> AG_OS --> EV_ORCAMENTO_DISPONIBILIZADO
            EV_ORCAMENTO_DISPONIBILIZADO --> RM_ORCAMENTO_CLIENTE
            AT_CLIENTE --> RM_ORCAMENTO_CLIENTE
            AT_CLIENTE --> CMD_APROVAR_ORCAMENTO --> AG_OS
            AG_OS -->|"versão vigente e dentro do prazo"| EV_ORCAMENTO_APROVADO
            AG_OS -->|"versão inválida ou expirada"| EV_APROVACAO_RECUSADA
            AT_CLIENTE --> CMD_REJEITAR_ORCAMENTO --> AG_OS --> EV_ORCAMENTO_REJEITADO
            EV_ORCAMENTO_REJEITADO --> POL_RETOMAR_DIAGNOSTICO --> AG_OS --> EV_DIAGNOSTICO_RETOMADO
        end

        subgraph EXECUCAO["Reserva, execução, finalização e entrega"]
            direction LR
            POL_RESERVAR_APROVACAO["Ao aprovar, reservar materiais"]:::politica
            POL_LIBERAR_EXECUCAO["Após reserva, liberar início da execução"]:::politica
            CMD_INICIAR_EXECUCAO["Iniciar execução"]:::comando
            EV_EXECUCAO_INICIADA["Execução iniciada<br/>status: EM_EXECUCAO"]:::evento
            POL_CONSUMIR_INICIO["Ao iniciar execução, consumir reserva"]:::politica
            CMD_FINALIZAR_OS["Finalizar ordem de serviço"]:::comando
            EV_OS_FINALIZADA["Ordem de serviço finalizada<br/>status: FINALIZADA"]:::evento
            AT_ATENDENTE_ENTREGA["Atendente"]:::ator
            CMD_REGISTRAR_ENTREGA["Registrar entrega do veículo"]:::comando
            EV_OS_ENTREGUE["Ordem de serviço entregue<br/>status: ENTREGUE"]:::evento

            EV_ORCAMENTO_APROVADO --> POL_RESERVAR_APROVACAO --> CMD_RESERVAR_MATERIAIS
            EV_MATERIAIS_RESERVADOS --> POL_LIBERAR_EXECUCAO --> CMD_INICIAR_EXECUCAO
            AT_MECANICO --> CMD_INICIAR_EXECUCAO --> AG_OS --> EV_EXECUCAO_INICIADA
            EV_EXECUCAO_INICIADA --> POL_CONSUMIR_INICIO --> CMD_CONSUMIR_RESERVA
            AT_MECANICO --> CMD_FINALIZAR_OS --> AG_OS --> EV_OS_FINALIZADA
            AT_ATENDENTE_ENTREGA --> CMD_REGISTRAR_ENTREGA --> AG_OS --> EV_OS_ENTREGUE
        end

        subgraph CANCELAMENTO["Fluxo alternativo de cancelamento"]
            direction LR
            CMD_CANCELAR_OS["Cancelar ordem de serviço"]:::comando
            EV_OS_CANCELADA["Ordem de serviço cancelada<br/>status: CANCELADA"]:::evento
            POL_ESTORNAR_CANCELAMENTO["Se houver reserva, estornar materiais"]:::politica

            AT_ATENDENTE --> CMD_CANCELAR_OS --> AG_OS --> EV_OS_CANCELADA
            EV_OS_CANCELADA --> POL_ESTORNAR_CANCELAMENTO --> CMD_ESTORNAR_RESERVA
        end

        EV_OS_RECEBIDA --> CMD_INICIAR_DIAGNOSTICO
        EV_DIAGNOSTICO_RETOMADO --> CMD_REGISTRAR_DIAGNOSTICO
        EV_MATERIAIS_CONSUMIDOS --> CMD_FINALIZAR_OS
        EV_OS_FINALIZADA --> CMD_REGISTRAR_ENTREGA
        EV_OS_RECEBIDA --> RM_OS_DETALHE
        EV_DIAGNOSTICO_INICIADO --> RM_OS_DETALHE
        EV_ORCAMENTO_DISPONIBILIZADO --> RM_OS_DETALHE
        EV_EXECUCAO_INICIADA --> RM_OS_DETALHE
        EV_OS_FINALIZADA --> RM_OS_DETALHE
        EV_OS_ENTREGUE --> RM_OS_DETALHE
        EV_OS_CANCELADA --> RM_OS_DETALHE
    end

    subgraph ACOMPANHAMENTO["BC - Acompanhamento do Cliente"]
        direction LR
        POL_ATUALIZAR_ACOMPANHAMENTO["Projetar alterações relevantes da OS"]:::politica
        RM_ACOMPANHAMENTO["Visão de acompanhamento<br/>status, orçamento e histórico"]:::leitura
        CMD_CONSULTAR_ANDAMENTO["Consultar andamento com acesso controlado"]:::comando
        EV_CONSULTA_REALIZADA["Consulta de andamento realizada"]:::evento

        EV_OS_RECEBIDA --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_DIAGNOSTICO_INICIADO --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_ORCAMENTO_DISPONIBILIZADO --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_ORCAMENTO_APROVADO --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_ORCAMENTO_REJEITADO --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_EXECUCAO_INICIADA --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_OS_FINALIZADA --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_OS_ENTREGUE --> POL_ATUALIZAR_ACOMPANHAMENTO
        EV_OS_CANCELADA --> POL_ATUALIZAR_ACOMPANHAMENTO
        POL_ATUALIZAR_ACOMPANHAMENTO --> RM_ACOMPANHAMENTO
        AT_CLIENTE --> CMD_CONSULTAR_ANDAMENTO --> RM_ACOMPANHAMENTO --> EV_CONSULTA_REALIZADA
    end

    subgraph INDICADORES["BC - Indicadores Operacionais"]
        direction LR
        POL_REGISTRAR_INTERVALO["Registrar intervalos em execução"]:::politica
        AG_INDICADOR["Indicador operacional"]:::agregado
        EV_INDICADOR_ATUALIZADO["Indicador atualizado"]:::evento
        RM_TEMPO_MEDIO["Tempo médio de execução por período/serviço"]:::leitura
        AT_GESTOR["Administrador / Gestor"]:::ator

        EV_EXECUCAO_INICIADA --> POL_REGISTRAR_INTERVALO
        EV_OS_FINALIZADA --> POL_REGISTRAR_INTERVALO
        POL_REGISTRAR_INTERVALO --> AG_INDICADOR --> EV_INDICADOR_ATUALIZADO --> RM_TEMPO_MEDIO
        AT_GESTOR --> RM_TEMPO_MEDIO
    end

    subgraph AUDITORIA_NOTIFICACAO["Suporte - Auditoria, Observabilidade e Notificações"]
        direction LR
        POL_AUDITAR["Registrar ator, ação, data/hora UTC e correlação"]:::politica
        EXT_LOGS["Logs, métricas e trilha de auditoria"]:::externo
        POL_NOTIFICAR_CLIENTE["Notificar cliente sobre orçamento e status"]:::politica
        EXT_CANAL_CLIENTE["Canal de notificação<br/>registro interno, e-mail ou aplicativo"]:::externo

        POL_AUDITAR --> EXT_LOGS
        POL_NOTIFICAR_CLIENTE --> EXT_CANAL_CLIENTE
        EV_ORCAMENTO_DISPONIBILIZADO --> POL_NOTIFICAR_CLIENTE
        EV_ORCAMENTO_REJEITADO --> POL_NOTIFICAR_CLIENTE
        EV_OS_FINALIZADA --> POL_NOTIFICAR_CLIENTE
        EV_ESTOQUE_MINIMO --> POL_NOTIFICAR_REPOSICAO
    end

    %% Integrações entre contextos e pré-condições do fluxo principal
    EXT_JWT -. autoriza comandos administrativos .-> AT_ATENDENTE
    EXT_JWT -. autoriza comandos administrativos .-> AT_MECANICO
    EXT_JWT -. autoriza comandos administrativos .-> AT_ADMIN_CATALOGO
    EXT_JWT -. autoriza comandos administrativos .-> AT_ADMIN_ESTOQUE
    RM_CLIENTE_VEICULO --> CMD_ABRIR_OS
    RM_SERVICOS_ATIVOS --> CMD_ADICIONAR_SERVICO
    RM_ESTOQUE_DISPONIVEL --> CMD_ADICIONAR_MATERIAL
    EV_RESERVA_RECUSADA --> AT_ADMIN_ESTOQUE
    EV_ENTRADA_REGISTRADA -. permite tentar a reserva novamente .-> CMD_RESERVAR_MATERIAIS

    %% Decisões do grupo e comportamentos definidos para esta versão
    HOT_PJ["Implementação MVP: um documento por cliente;<br/>CPF exige nascimento e idade > 18;<br/>CNPJ não usa data de nascimento;<br/>campo nome representa nome/razão social"]:::hotspot
    HOT_SEM_ESTOQUE["Regra MVP: aprovação só é efetivada<br/>quando a reserva atômica tem saldo suficiente;<br/>caso contrário, transação não confirma"]:::hotspot
    HOT_ACESSO_CLIENTE["MVP: código aleatório de acompanhamento<br/>entregue na abertura; consulta e decisão<br/>do orçamento usam esse código"]:::hotspot
    HOT_PRAZO_ORCAMENTO["MVP: orçamento sem expiração automática;<br/>aprovação exige versão vigente e disponibilizada"]:::hotspot

    AG_CLIENTE -.-> HOT_PJ
    EV_RESERVA_RECUSADA -.-> HOT_SEM_ESTOQUE
    CMD_CONSULTAR_ANDAMENTO -.-> HOT_ACESSO_CLIENTE
    EV_ORCAMENTO_GERADO -.-> HOT_PRAZO_ORCAMENTO

    %% Eventos relevantes alimentam auditoria; a lista representa a política transversal.
    EV_CLIENTE_CADASTRADO -.-> POL_AUDITAR
    EV_VEICULO_CADASTRADO -.-> POL_AUDITAR
    EV_OS_RECEBIDA -.-> POL_AUDITAR
    EV_ORCAMENTO_APROVADO -.-> POL_AUDITAR
    EV_MATERIAIS_RESERVADOS -.-> POL_AUDITAR
    EV_EXECUCAO_INICIADA -.-> POL_AUDITAR
    EV_OS_FINALIZADA -.-> POL_AUDITAR
    EV_OS_ENTREGUE -.-> POL_AUDITAR
    EV_OS_CANCELADA -.-> POL_AUDITAR

    classDef ator fill:#F9E27D,stroke:#8A6D00,color:#1F1F1F,stroke-width:2px;
    classDef comando fill:#8DB9F4,stroke:#245B9E,color:#10243E,stroke-width:2px;
    classDef agregado fill:#FFE699,stroke:#9C7A00,color:#2B2400,stroke-width:3px;
    classDef evento fill:#F4A261,stroke:#A64B00,color:#321800,stroke-width:2px;
    classDef politica fill:#C9A7EB,stroke:#6D3A9C,color:#281438,stroke-width:2px;
    classDef leitura fill:#9FD5A8,stroke:#347A42,color:#15351B,stroke-width:2px;
    classDef externo fill:#E8B4D4,stroke:#9C4679,color:#3A172D,stroke-width:2px;
    classDef hotspot fill:#F28482,stroke:#A4161A,color:#3D0809,stroke-width:3px,stroke-dasharray:5 5;

